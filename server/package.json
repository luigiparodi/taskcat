{
  "name": "taskcat-app server",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "node ./node_modules/typescript/bin/tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:contracts": "jest --testPathPatterns=contracts --passWithNoTests",
    "lint": "eslint src/ --ext .ts,.js"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ],
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts",
      "!src/__tests__/**"
    ],
    "coverageDirectory": "coverage",
    "testPathIgnorePatterns": [
      "<rootDir>/dist/",
      "<rootDir>/node_modules/"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  },
  "keywords": [],
  "type": "commonjs",
  "dependencies": {
    "@google/genai": "2.27.0",
    "@types/bcryptjs": "2.4.6",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "^26.6.5",
    "bcryptjs": "3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jest": "^30.5.2",
    "jsonwebtoken": "9.0.3",
    "mammoth": "1.13.0",
    "mongodb": "^7.6.0",
    "multer": "2.4.0",
    "pdf-parse": "2.4.5",
    "supertest": "^7.3.0",
    "swagger-ui-express": "5.0.1",
    "ts-jest": "^29.4.12",
    "ts-node-dev": "^2.0.0",
    "typescript": "5.9.2",
    "winston": "3.19.0"
  },
  "devDependencies": {
    "@faker-js/faker": "10.6.0",
    "@types/cors": "2.8.19",
    "@types/multer": "2.3.0",
    "@types/pdf-parse": "1.1.5",
    "@types/supertest": "7.2.1",
    "@types/swagger-jsdoc": "6.0.4",
    "@types/swagger-ui-express": "4.1.8",
    "mongodb-memory-server": "11.3.0",
    "swagger-jsdoc": "6.3.0",
    "ts-node": "10.9.2"
  },
  "allowScripts": {
    "mongodb-memory-server@11.3.0": true,
    "@google/genai@2.27.0": true,
    "@parcel/watcher@2.6.0": true,
    "@scarf/scarf@1.4.0": true,
    "protobufjs@7.6.6": true,
    "unrs-resolver@1.12.2": true
  }
}
