PORT=3000
DATABASE_URL=EXAMPLE
DATABASE_NAME=Cat-task
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
GITHUB_CLIENT_ID=TOKEN
GITHUB_CLIENT_SECRET=TOKEN
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback

# Comma-separated list of browser origins allowed to call this API.
# Unset (or blank) falls back to the Vite dev origins only:
#   http://localhost:5173, http://127.0.0.1:5173
# That fallback is deliberately narrow so a misconfigured production deploy
# fails visibly instead of accepting any origin.
# Example for a real deploy (set this, do not rely on the default):
# CORS_ORIGINS=https://taskcat.example.com
CORS_ORIGINS=

# Google Gemini API key used by the AI/Import chunk (see src/config/gemini.ts).
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Use an alias like gemini-flash-latest so the model stays available as Google
# retires older ids (gemini-2.5-flash returns 404 for new API keys).
GEMINI_MODEL=gemini-flash-latest
# Comma-separated models tried in order when the primary is busy (503) or gone (404).
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-3.6-flash