# Base URL the browser uses for API calls.
#
# Leave unset for local development: the default "/api" is proxied by Vite to
# http://localhost:3000 (see vite.config.ts), so no CORS preflight is needed.
#
# For a production deploy where the API lives on another origin, set an
# absolute URL and make sure that exact origin is listed in the server's
# CORS_ORIGINS variable:
# VITE_API_BASE=https://api.taskcat.example.com
#
# Note: the server mounts routes at /auth, /users and /projects with NO /api
# prefix, so VITE_API_BASE must not include a trailing /api unless your reverse
# proxy strips it (which the Vite dev proxy does).
#
# Leave commented out for local development. An empty value is also treated as
# unset (the code uses || not ??), but commenting it out is clearer.
# VITE_API_BASE=https://api.taskcat.example.com